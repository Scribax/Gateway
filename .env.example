# Docker. The defaults in docker-compose.yml let the stack start without a .env.
NEW_API_IMAGE=ghcr.io/scribax/gateway-new-api:latest
NEW_API_VERSION=v1.0.0-rc.24
NEW_API_PORT=3000
POSTGRES_USER=newapi
POSTGRES_PASSWORD=newapi_local_db_2026
POSTGRES_DB=newapi
REDIS_PASSWORD=newapi_local_redis_2026
SESSION_SECRET=local_session_secret_9f31c8776eb04f71a325b7446f957aca
CRYPTO_SECRET=local_crypto_secret_61a0e0f6c2044be2b9e3e76bd33d5f22
TZ=America/Argentina/Buenos_Aires
GIN_MODE=debug
DEBUG=true
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=new-api-local

# Friendly customer portal.
PORTAL_PORT=3100
PORTAL_NAME=Orbiqen
PUBLIC_GATEWAY_URL=http://127.0.0.1:3000/v1
PORTAL_COOKIE_SECURE=false
# Optional server-side live probes. Never expose this key to the browser.
STATUS_PROBE_BASE_URL=https://api.wluvyh.cloud/v1
STATUS_PROBE_API_KEY=
# Estimate only until the provider supplies a reconciled invoice/API.
UPSTREAM_COST_FACTOR=0.1
PAYMENT_FEE_RATE=0.035

# Mercado Pago Checkout Pro. Keep access/admin tokens only in the VPS .env.
PUBLIC_PORTAL_URL=http://127.0.0.1:3100
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# NOWPayments crypto invoices. Keep both values only in the VPS .env.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
# Long-lived New API admin token used only by the payment webhook.
NEW_API_ADMIN_TOKEN=

# Test clients. Paste the sub-key created in the New API panel.
NEW_API_BASE_URL=http://127.0.0.1:3000/v1
NEW_API_KEY=sk-replace-with-your-local-sub-key
TEST_MODEL=gpt-5.4-mini
REQUEST_TIMEOUT=120
