# Docker. The defaults in docker-compose.yml let the stack start without a .env.
NEW_API_IMAGE=calciumion/new-api:v1.0.0-rc.24
NEW_API_PORT=3000
POSTGRES_USER=newapi
POSTGRES_PASSWORD=newapi_local_db_2026
POSTGRES_DB=newapi
REDIS_PASSWORD=newapi_local_redis_2026
SESSION_SECRET=local_session_secret_9f31c8776eb04f71a325b7446f957aca
CRYPTO_SECRET=local_crypto_secret_61a0e0f6c2044be2b9e3e76bd33d5f22
TZ=America/Argentina/Buenos_Aires
GIN_MODE=debug
DEBUG=true
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=new-api-local

# Friendly customer portal.
PORTAL_PORT=3100
PORTAL_NAME=Orbiqen
PUBLIC_GATEWAY_URL=http://127.0.0.1:3000/v1
PORTAL_COOKIE_SECURE=false

# Test clients. Paste the sub-key created in the New API panel.
NEW_API_BASE_URL=http://127.0.0.1:3000/v1
NEW_API_KEY=sk-replace-with-your-local-sub-key
TEST_MODEL=gpt-5.4-mini
REQUEST_TIMEOUT=120
